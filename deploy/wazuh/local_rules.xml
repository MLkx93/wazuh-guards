<!--
  Wazuh rules for the Claude Code guardrail.
  Install to /var/ossec/etc/rules/local_rules.xml on the manager, then:
      /var/ossec/bin/wazuh-control restart

  Every field matched here is an aggregated SCALAR under guardrail.*. This is
  deliberate: Wazuh's JSON decoder flattens arrays to findings.0.rule,
  findings.1.rule, ... so a rule matching findings.0.severity MISSES a
  high-severity finding sitting at index 1. Never write rules against indices.

  Level guide used below:
     3  informational  - PII warned in a prompt
    10  serious        - a credential was typed and blocked
    12  critical       - a secret exists at rest in the codebase
    13  critical+      - repeated/unremediated
-->
<group name="claude_guardrail,">

  <!-- Base. Every guardrail event matches this and nothing else does. -->
  <rule id="100200" level="0">
    <decoded_as>json</decoded_as>
    <field name="guardrail.action">\.+</field>
    <description>Claude Code guardrail event</description>
  </rule>

  <!-- PII detected in a prompt. The prompt PROCEEDS: UserPromptSubmit cannot
       rewrite it, so this is a record, not an interception. -->
  <rule id="100201" level="3">
    <if_sid>100200</if_sid>
    <field name="guardrail.action">^warn$</field>
    <description>Guardrail: personal data in prompt ($(guardrail.rules)) - NOT redacted</description>
    <group>gdpr_IV_35.7.d,pii,</group>
  </rule>

  <!-- A credential was typed into a prompt and the prompt was rejected. -->
  <rule id="100202" level="10">
    <if_sid>100200</if_sid>
    <field name="guardrail.action">^block$</field>
    <description>Guardrail: credential in prompt blocked ($(guardrail.rules))</description>
    <group>pci_dss_3.4,gdpr_IV_35.7.d,credential_exposure,</group>
  </rule>

  <!-- THE HIGHEST-VALUE SIGNAL HERE.
       Output redaction fired on a high-severity match, which means a live
       secret is sitting in a file or command output in the codebase. Unlike a
       blocked prompt (a user mistake, already prevented), this is a secret at
       rest that will keep being read until someone rotates it. -->
  <rule id="100203" level="12">
    <if_sid>100200</if_sid>
    <field name="guardrail.action">^output_redacted$</field>
    <field name="guardrail.has_high">^true$</field>
    <description>Guardrail: secret at rest redacted from $(guardrail.tool) output - $(guardrail.target) ($(guardrail.rules))</description>
    <group>pci_dss_3.4,secret_at_rest,credential_exposure,</group>
  </rule>

  <!-- Redaction fired but only on low-severity matches. Informational: the
       REDACT_SEVERITIES policy means this should be rare. -->
  <rule id="100204" level="5">
    <if_sid>100200</if_sid>
    <field name="guardrail.action">^output_redacted$</field>
    <field name="guardrail.has_high">^false$</field>
    <description>Guardrail: low-severity data redacted from $(guardrail.tool) output</description>
  </rule>

  <!-- A read of a protected path was denied before it reached context. -->
  <rule id="100205" level="6">
    <if_sid>100200</if_sid>
    <field name="guardrail.action">^read_denied$</field>
    <description>Guardrail: denied read of protected path $(guardrail.target)</description>
    <group>credential_exposure,</group>
  </rule>

  <!-- The guardrail itself failed. An error here means output was NOT
       redacted, so it is graded as an exposure, not as noise. -->
  <rule id="100206" level="10">
    <if_sid>100200</if_sid>
    <field name="guardrail.action">^error$</field>
    <description>Guardrail FAILURE on $(guardrail.hook) - output was not scanned: $(guardrail.error)</description>
    <group>guardrail_failure,</group>
  </rule>

  <!-- Running without the NLP model: credentials still blocked, but names,
       emails and phone numbers are being missed. -->
  <rule id="100207" level="5">
    <if_sid>100200</if_sid>
    <field name="guardrail.mode">^fallback$</field>
    <description>Guardrail: daemon down on $(guardrail.host) - regex-only, NLP PII undetected</description>
    <group>guardrail_degraded,</group>
  </rule>

  <!-- ===================== correlation ===================== -->

  <!-- Five blocks in five minutes from one session: not a slip. Either someone
       is pasting a credential file piecewise, or a tool is echoing secrets. -->
  <rule id="100210" level="12" frequency="5" timeframe="300">
    <if_matched_sid>100202</if_matched_sid>
    <same_field>guardrail.session_id</same_field>
    <description>Guardrail: repeated credential submission - 5 blocks in 300s (session $(guardrail.session_id))</description>
    <group>credential_exposure,correlation,</group>
  </rule>

  <!-- The same file leaking three times in a day means nobody rotated it after
       the first alert. This is the unremediated-finding signal. -->
  <rule id="100211" level="13" frequency="3" timeframe="86400">
    <if_matched_sid>100203</if_matched_sid>
    <same_field>guardrail.target</same_field>
    <description>Guardrail: UNREMEDIATED - $(guardrail.target) leaked 3x in 24h, secret not rotated</description>
    <group>secret_at_rest,correlation,</group>
  </rule>

  <!-- Repeated denials of protected paths across one session. -->
  <rule id="100212" level="10" frequency="5" timeframe="600">
    <if_matched_sid>100205</if_matched_sid>
    <same_field>guardrail.session_id</same_field>
    <description>Guardrail: repeated attempts to read protected paths (session $(guardrail.session_id))</description>
    <group>credential_exposure,correlation,</group>
  </rule>

  <!-- ===================== drift ===================== -->
  <!--
    The payoff for central pattern management: knowing every host is actually
    enforcing the patterns you published.

    pattern_sha is the sha256 of the exact bytes of patterns.json. Set the
    expected value below after each publish. A host reporting a different sha
    is running stale or locally-modified patterns.

    Sync this with: guardrailctl patterns   (prints the sha)
  -->
  <rule id="100220" level="10">
    <if_sid>100200</if_sid>
    <field name="guardrail.pattern_sha">\.+</field>
    <match>REPLACE_WITH_EXPECTED_SHA256</match>
    <check_diff />
    <description>Guardrail: pattern drift on $(guardrail.host) - sha $(guardrail.pattern_sha) is not the published set</description>
    <group>guardrail_drift,</group>
  </rule>

  <!-- A host running bundled defaults never successfully fetched from the
       manager -- central management is not actually in effect there. -->
  <rule id="100221" level="7">
    <if_sid>100200</if_sid>
    <field name="guardrail.pattern_source">^bundled$</field>
    <description>Guardrail: $(guardrail.host) is on bundled patterns - never fetched from manager</description>
    <group>guardrail_drift,</group>
  </rule>

</group>
